{
  "name": "Project Genesis",
  "globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 640
      },
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true,
          "WaterTransparency": 0.6,
          "WaterWaveSize": 0.1
        }
      },
      "GenesisInstallation": {
        "$path": "assets/installation.model.json"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.36, 0.38, 0.42],
        "OutdoorAmbient": [0.47, 0.49, 0.54],
        "Brightness": 3,
        "ClockTime": 15.2,
        "GeographicLatitude": 30,
        "ExposureCompensation": 0.1,
        "ShadowSoftness": 0.25,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.2,
          "Haze": 1.2,
          "Glare": 0.2,
          "Color": [0.8, 0.86, 0.92],
          "Decay": [0.6, 0.66, 0.72]
        }
      },
      "Cores": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.06,
          "Contrast": 0.1,
          "TintColor": [1, 0.985, 0.96]
        }
      },
      "Brilho": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.4, "Size": 22, "Threshold": 1.7 }
      },
      "Raios": {
        "$className": "SunRaysEffect",
        "$properties": { "Intensity": 0.06, "Spread": 0.7 }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "GenesisShared": {
        "$path": "out/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "GenesisServer": {
        "$path": "out/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMinZoomDistance": 0.5,
        "CameraMaxZoomDistance": 20,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "GenesisClient": {
          "$path": "out/client"
        }
      }
    }
  }
}
